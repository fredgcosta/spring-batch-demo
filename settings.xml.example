<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ============================================================================
  EXEMPLO de configuracao de credenciais do Maven para o Code Genome Project.

  Este arquivo NAO deve conter valores reais e NAO substitui automaticamente o
  seu settings.xml. Para usar:

    1. Copie este arquivo para ~/.m2/settings.xml
         cp settings.xml.example ~/.m2/settings.xml
       (ou passe explicitamente na linha de comando: ./mvnw -s settings.xml.example ...)

    2. Exporte as variaveis de ambiente com as credenciais do Code Genome:
         export CODEGENOME_USER=seu-usuario-ou-email
         export CODEGENOME_TOKEN=seu-token-de-download

  O <server> abaixo tem id="code-genome", que DEVE casar exatamente com o id do
  <repository>/<pluginRepository> declarado no pom.xml. O Maven usa esse id para
  associar as credenciais ao repositorio autenticado que distribui a
  Recipe_UpgradeToJava25 (Moderne Source Available License).

  NAO comite credenciais reais no repositorio.
  ============================================================================
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <servers>
    <server>
      <id>code-genome</id>
      <username>${env.CODEGENOME_USER}</username>
      <password>${env.CODEGENOME_TOKEN}</password>
    </server>
  </servers>
</settings>
